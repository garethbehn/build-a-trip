{
  "version": 2,
  "routes": [
    {
      "src": "/api/search",
      "dest": "/api/search.js"
    },
    {
      "src": "/api/flights",
      "dest": "/api/flights.js"
    },
    {
      "src": "/api/hotels",
      "dest": "/api/hotels.js"
    },
    {
      "src": "/api/booking",
      "dest": "/api/booking.js"
    },
    {
      "src": "/api/tour",
      "dest": "/api/tour.js"
    },
    {
      "src": "/trip/(.*)",
      "dest": "/trip.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}